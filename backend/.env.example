# ----- Server -----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ----- Firebase Admin (service account) -----
# From Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key".
# The downloaded JSON contains these three values. Paste them here.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n escapes exactly as they appear in the JSON, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...your...key...\n-----END PRIVATE KEY-----\n"

# Alternative to the three vars above: point to the downloaded JSON file instead.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
